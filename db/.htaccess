# ============================================================
# PROTEKSI DIREKTORI DATABASE
# ============================================================
# File ini WAJIB ada di /db/ untuk memblokir akses HTTP
# langsung ke file database.sqlite.
#
# Kalau file ini hilang atau salah konfigurasi, database lo
# bisa didownload siapapun lewat browser. Ampas banget.
# ============================================================

# --- Metode 1: Apache 2.4+ (mod_authz_core) ---
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# --- Metode 2: Apache 2.2 Legacy (mod_access_compat) ---
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>

# --- Blokir akses langsung ke file database ---
<FilesMatch "\.(sqlite|sqlite3|db|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Disable directory listing ---
Options -Indexes
